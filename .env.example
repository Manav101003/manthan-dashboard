# ============================================================
# Mathan Institute Dashboard - Environment Configuration
# ============================================================

# Environment Mode: 'development' or 'production'
NODE_ENV=production

# Server Port
PORT=3000

# Session Secret (Use a strong random string in production)
SESSION_SECRET=your_super_secret_session_key_here

# ------------------------------------------------------------
# Database Configuration
# ------------------------------------------------------------
# Option A: Full Connection String (Standard on Render, Railway, Supabase, Neon, Heroku)
DATABASE_URL=postgresql://user:password@hostname:5432/dbname?sslmode=require

# Option B: Discrete Parameters (Used if DATABASE_URL is not set)
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=manthan_institute
DB_PORT=5432
DB_SSL=false
DB_POOL_MAX=10

# ------------------------------------------------------------
# Security & Network
# ------------------------------------------------------------
# Set to 'true' if behind a reverse proxy (Nginx, Render, Cloudflare, etc.)
TRUST_PROXY=true
# Set to 'true' if serving via HTTPS
COOKIE_SECURE=false
CORS_ORIGIN=*

# ------------------------------------------------------------
# Initial Setup (Used only on initial setup-db run)
# ------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_admin_password
ADMIN_EMAIL=admin@manthaninstitute.com

# ------------------------------------------------------------
# Default Institute UPI Details (Optional)
# ------------------------------------------------------------
UPI_ID=
UPI_NAME=Mathan Institute
